+/**
+ * Avoid recursively binding an Apptainer overlay root into a nested user
+ * namespace. Keep the container-visible filesystem while omitting control
+ * mounts that the MiMo wrapper already treats as private.
+ */
+function containerScopedFilesystemArgs(args) {
+    const rewritten = ['--tmpfs', '/', '--dev-bind', '/dev', '/dev'];
+    const omitted = new Set(['dev', 'proc', 'run', 'staging', 'tmp']);
+    for (const name of fs.readdirSync('/').sort()) {
+        if (omitted.has(name))
+            continue;
+        const source = `/${name}`;
+        let info;
+        try {
+            info = fs.lstatSync(source);
+        }
+        catch {
+            continue;
+        }
+        if (info.isSymbolicLink()) {
+            rewritten.push('--symlink', fs.readlinkSync(source), source);
+        }
+        else if (info.isDirectory() || info.isFile()) {
+            rewritten.push(name === 'sys' ? '--ro-bind' : '--bind', source, source);
+        }
+    }
+    rewritten.push('--tmpfs', '/run', '--bind', '/tmp', '/tmp');
+    for (let index = 0; index < args.length;) {
+        if ((args[index] === '--bind' || args[index] === '--ro-bind') &&
+            args[index + 1] === '/' &&
+            args[index + 2] === '/') {
+            index += 3;
+            continue;
+        }
+        rewritten.push(args[index]);
+        index += 1;
+    }
+    return rewritten;
+}
