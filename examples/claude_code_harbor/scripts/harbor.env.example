# Copy to a private file outside Git, edit the paths, then pass --env-file FILE.
# Run once on the head of an already allocated, dedicated 16 x 8 H800 Ray cluster.
# This shell file is sourced. Keep credentials in the existing secure environment.
CLOUD_ROOT=/your/shared/cloud/mount
# REPO defaults to the checkout containing run-harbor.sh.

# Original dataset plus all referenced task uploads must be mounted.
SOURCE_ROOT=inputs/harbor-source
BBS_WHEEL_PATH=inputs/wheels/dressage_blackbox_server-1.0.0-py3-none-any.whl
DRESSAGE_WHEEL_PATH=inputs/wheels/dressage-0.1.0-py3-none-any.whl

# DATA_ROOT and BUNDLE_DIR must be new directories on the shared cloud.
DATA_ROOT=harbor/prepared-v1
BUNDLE_DIR=harbor/runs/run-001/bundle
MODEL_DIR=models                    # Contains Qwen3.6-35B-A3B/ and its weight shards.
SAVE_DIR=harbor/checkpoints         # Persistent root, independent of each run bundle.
EXP_NAME=qwen36-35b-a3b-harbor-128h800-hybrid
PROJECT_NAME=Relax/agentic/claude-code-harbor

# Reuse prepared data after manifest/size/routing checks (no raw inputs needed):
# HARBOR_REUSE_DATA=1
# DATA_ROOT=harbor/prepared-v1
# Reuse Gym at its original final path; checks write only into the new bundle:
# GYM_RUNTIME_DIR=harbor/runs/previous/bundle/runtime/gym
# Optional pre-downloaded, pinned OCI package archives (otherwise downloaded):
# OCI_PACKAGES_DIR=harbor/oci-packages

# Optional platform overrides; otherwise discover Ray/head from the local cluster.
# RAY_ADDRESS=<head-ip>:6379
# RAY_DASHBOARD_ADDRESS=http://<head-ip>:8265
# MEGATRON=/root/Megatron-LM
# GYM_PORT=27980
# GYM_UPLINK_PORT=27981
# OCI_ROOT is generated as a short, unique node-local path; normally leave unset.
