--- /dev/null
+++ b/src/policies/session_least_load.rs
@@ -0,0 +1,424 @@
+//! Session-scoped decode placement. Data requests reserve load before dispatch;
+//! bindings survive tool waits and are never moved on health changes or a TTL.
+use std::{
+    collections::HashMap,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+};
+
+use async_trait::async_trait;
+use http::HeaderMap;
+use parking_lot::Mutex;
+use serde_json::{json, Value};
+
+use super::{LoadBalancingPolicy, SelectWorkerInfo};
+use crate::core::{Worker, WorkerLoadGuard};
+
+const MAX_ENTRIES: usize = 1_000_000;
+type Key = (String, String);
+
+#[derive(Debug)]
+struct Binding {
+    worker: Option<Arc<dyn Worker>>,
+    active: usize,
+    uncertain: usize,
+    closing: bool,
+}
+
+#[derive(Debug, Default)]
+struct WorkerCounts {
+    url: String,
+    bound: usize,
+    active: usize,
+    uncertain: usize,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    bindings: HashMap<Key, Binding>,
+    workers: HashMap<usize, WorkerCounts>,
+    cursor: usize,
+    assignments: u64,
+    reuses: u64,
+    rejected: u64,
+}
+
+fn identity(worker: &Arc<dyn Worker>) -> usize {
+    Arc::as_ptr(worker) as *const () as usize
+}
+
+#[derive(Debug, Default)]
+pub struct SessionLeastLoadPolicy {
+    state: Arc<Mutex<State>>,
+}
+
+impl SessionLeastLoadPolicy {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn reserve(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        model: &str,
+        session: &str,
+        headers: Option<&HeaderMap>,
+    ) -> Result<(Arc<dyn Worker>, SessionRequest), String> {
+        if session.is_empty() || session.len() > 512 {
+            return Err("invalid session routing key".into());
+        }
+        let key = (model.to_owned(), session.to_owned());
+        let mut state = self.state.lock();
+        let worker = if let Some(binding) = state.bindings.get(&key) {
+            if binding.closing || binding.uncertain > 0 {
+                state.rejected += 1;
+                return Err("session binding is closed or cleanup is unconfirmed".into());
+            }
+            let assigned = binding.worker.as_ref().expect("open binding owns worker");
+            // URL equality alone must not silently transfer ownership to a new
+            // worker incarnation registered at the same address.
+            if !workers
+                .iter()
+                .any(|w| Arc::ptr_eq(w, assigned) && w.is_available())
+            {
+                state.rejected += 1;
+                return Err(
+                    "bound decode worker is unavailable; automatic migration is disabled".into(),
+                );
+            }
+            let worker = assigned.clone();
+            state.reuses += 1;
+            worker
+        } else {
+            if state.bindings.len() >= MAX_ENTRIES {
+                state.rejected += 1;
+                return Err("session routing table capacity reached".into());
+            }
+            let mut candidates: Vec<_> = workers
+                .iter()
+                .filter(|w| w.is_available())
+                .cloned()
+                .collect();
+            candidates.sort_by(|a, b| a.url().cmp(b.url()));
+            if candidates.is_empty() {
+                return Err("no available decode worker".into());
+            }
+            let cursor = state.cursor % candidates.len();
+            let index = (0..candidates.len())
+                .min_by_key(|&i| {
+                    let worker = &candidates[i];
+                    let counts = state.workers.get(&identity(worker));
+                    (
+                        worker
+                            .load()
+                            .saturating_add(counts.map_or(0, |c| c.uncertain)),
+                        counts.map_or(0, |c| c.bound),
+                        (i + candidates.len() - cursor) % candidates.len(),
+                    )
+                })
+                .expect("nonempty candidates");
+            state.cursor = index + 1;
+            let worker = candidates[index].clone();
+            state
+                .workers
+                .entry(identity(&worker))
+                .or_insert_with(|| WorkerCounts {
+                    url: worker.url().to_string(),
+                    ..Default::default()
+                })
+                .bound += 1;
+            state.bindings.insert(
+                key.clone(),
+                Binding {
+                    worker: Some(worker.clone()),
+                    active: 0,
+                    uncertain: 0,
+                    closing: false,
+                },
+            );
+            state.assignments += 1;
+            worker
+        };
+        state.bindings.get_mut(&key).expect("binding exists").active += 1;
+        state
+            .workers
+            .get_mut(&identity(&worker))
+            .expect("worker exists")
+            .active += 1;
+        // Increment the actual Router worker load while holding the placement
+        // lock: simultaneous first turns cannot all observe the same empty DP.
+        let load = WorkerLoadGuard::new(worker.clone(), headers);
+        let request = SessionRequest(Arc::new(RequestInner {
+            state: self.state.clone(),
+            key,
+            worker_id: identity(&worker),
+            dispatched: AtomicBool::new(false),
+            terminal: AtomicBool::new(false),
+            _load: load,
+        }));
+        Ok((worker, request))
+    }
+
+    pub fn close(&self, model: &str, session: &str) -> Result<Value, String> {
+        if session.is_empty() || session.len() > 512 {
+            return Err("invalid session routing key".into());
+        }
+        let key = (model.to_owned(), session.to_owned());
+        let mut state = self.state.lock();
+        if !state.bindings.contains_key(&key) && state.bindings.len() >= MAX_ENTRIES {
+            return Err("session routing table capacity reached".into());
+        }
+        // Keep a compact tombstone for this Router's lifetime. A delayed first
+        // request must not reopen a closed session. No idle TTL moves live sessions.
+        state
+            .bindings
+            .entry(key.clone())
+            .or_insert(Binding {
+                worker: None,
+                active: 0,
+                uncertain: 0,
+                closing: true,
+            })
+            .closing = true;
+        Self::release_closed(&mut state, &key);
+        let binding = &state.bindings[&key];
+        Ok(json!({
+            "sealed": true, "active_requests": binding.active,
+            "cleanup_unconfirmed": binding.uncertain,
+            "binding_released": binding.worker.is_none(),
+            "physical_cleanup_confirmed": false
+        }))
+    }
+
+    fn release_closed(state: &mut State, key: &Key) {
+        let binding = state.bindings.get_mut(key).expect("binding exists");
+        if binding.closing && binding.active == 0 && binding.uncertain == 0 {
+            if let Some(worker) = binding.worker.take() {
+                let id = identity(&worker);
+                let counts = state.workers.get_mut(&id).expect("worker counts exist");
+                counts.bound -= 1;
+                if counts.bound == 0 && counts.uncertain == 0 {
+                    state.workers.remove(&id);
+                }
+            }
+        }
+    }
+
+    pub fn snapshot(&self) -> Value {
+        let state = self.state.lock();
+        let per_worker: Vec<_> = state.workers.values().map(|w| json!({
+            "worker": w.url, "bound_sessions": w.bound, "active_requests": w.active, "cleanup_unconfirmed": w.uncertain,
+        })).collect();
+        json!({
+            "policy": "session_least_load",
+            "open_bindings": state.bindings.values().filter(|b| !b.closing).count(),
+            "closing_bindings": state.bindings.values().filter(|b| b.closing && b.worker.is_some()).count(),
+            "closed_tombstones": state.bindings.values().filter(|b| b.worker.is_none()).count(),
+            "active_requests": state.bindings.values().map(|b| b.active).sum::<usize>(),
+            "cleanup_unconfirmed": state.bindings.values().map(|b| b.uncertain).sum::<usize>(),
+            "assignments": state.assignments, "reuses": state.reuses, "rejected": state.rejected,
+            "max_entries": MAX_ENTRIES, "workers": per_worker,
+        })
+    }
+}
+
+#[derive(Clone)]
+pub struct SessionRequest(Arc<RequestInner>);
+
+struct RequestInner {
+    state: Arc<Mutex<State>>,
+    key: Key,
+    worker_id: usize,
+    dispatched: AtomicBool,
+    terminal: AtomicBool,
+    _load: WorkerLoadGuard,
+}
+
+impl SessionRequest {
+    pub fn dispatched(&self) {
+        self.0.dispatched.store(true, Ordering::Release);
+    }
+    pub fn terminal(&self) {
+        self.0.terminal.store(true, Ordering::Release);
+    }
+}
+
+impl Drop for RequestInner {
+    fn drop(&mut self) {
+        let mut state = self.state.lock();
+        let uncertain =
+            self.dispatched.load(Ordering::Acquire) && !self.terminal.load(Ordering::Acquire);
+        let binding = state
+            .bindings
+            .get_mut(&self.key)
+            .expect("request owns binding");
+        binding.active -= 1;
+        if uncertain {
+            binding.uncertain += 1;
+            state
+                .workers
+                .get_mut(&self.worker_id)
+                .expect("request owns worker")
+                .uncertain += 1;
+        }
+        state
+            .workers
+            .get_mut(&self.worker_id)
+            .expect("worker exists")
+            .active -= 1;
+        SessionLeastLoadPolicy::release_closed(&mut state, &self.key);
+        // WorkerLoadGuard drops after this lock is released.
+    }
+}
+
+#[async_trait]
+impl LoadBalancingPolicy for SessionLeastLoadPolicy {
+    async fn select_worker(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        info: &SelectWorkerInfo<'_>,
+    ) -> Option<usize> {
+        // Anonymous health probes have no session. Generation must use reserve()
+        // in the HTTP PD path, which owns the terminal-response receipt.
+        if info
+            .headers
+            .is_some_and(|h| h.contains_key("x-smg-routing-key"))
+        {
+            return None;
+        }
+        workers
+            .iter()
+            .enumerate()
+            .filter(|(_, w)| w.is_available())
+            .min_by_key(|(_, w)| w.load())
+            .map(|(i, _)| i)
+    }
+    fn name(&self) -> &'static str {
+        "session_least_load"
+    }
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::core::{DPAwareWorkerBuilder, WorkerType};
+    fn workers() -> Vec<Arc<dyn Worker>> {
+        (0..12)
+            .map(|i| {
+                Arc::new(
+                    DPAwareWorkerBuilder::new(format!("http://d{}:8000", i / 2), i % 2, 2)
+                        .worker_type(WorkerType::Decode)
+                        .build(),
+                ) as Arc<dyn Worker>
+            })
+            .collect()
+    }
+    #[test]
+    fn concurrent_first_turns_reserve_atomically_across_twelve_dps() {
+        let policy = Arc::new(SessionLeastLoadPolicy::new());
+        let workers = workers();
+        let gate = Arc::new(std::sync::Barrier::new(97));
+        let mut handles = vec![];
+        for i in 0..96 {
+            let (policy, workers, gate) = (policy.clone(), workers.clone(), gate.clone());
+            handles.push(std::thread::spawn(move || {
+                gate.wait();
+                policy
+                    .reserve(&workers, "m", &format!("s{i}"), None)
+                    .unwrap()
+            }));
+        }
+        gate.wait();
+        let reservations: Vec<_> = handles.into_iter().map(|h| h.join().unwrap()).collect();
+        assert!(workers.iter().all(|w| w.load() == 8));
+        assert_eq!(policy.snapshot()["active_requests"], 96);
+        drop(reservations); // never dispatched: no quarantine
+        assert!(workers.iter().all(|w| w.load() == 0));
+        assert_eq!(policy.snapshot()["cleanup_unconfirmed"], 0);
+    }
+    #[test]
+    fn sticky_across_idle_and_health_changes_but_not_worker_incarnations() {
+        let policy = SessionLeastLoadPolicy::new();
+        let workers = workers();
+        let (first, receipt) = policy.reserve(&workers, "m", "s", None).unwrap();
+        receipt.dispatched();
+        receipt.terminal();
+        drop(receipt);
+        // Artificial load does not move an existing binding.
+        first.increment_load();
+        let (again, receipt) = policy.reserve(&workers, "m", "s", None).unwrap();
+        assert!(Arc::ptr_eq(&first, &again));
+        drop(receipt);
+        first.decrement_load();
+        first.set_healthy(false);
+        assert!(policy.reserve(&workers, "m", "s", None).is_err());
+        first.set_healthy(true);
+        assert!(policy.reserve(&self::workers(), "m", "s", None).is_err());
+        assert!(policy.reserve(&workers, "m", "s", None).is_ok());
+    }
+    #[test]
+    fn idle_binding_count_breaks_equal_load_ties_and_close_seals_late_requests() {
+        let policy = SessionLeastLoadPolicy::new();
+        let workers = workers();
+        let mut selected = std::collections::HashSet::new();
+        for i in 0..12 {
+            let (worker, receipt) = policy
+                .reserve(&workers, "m", &format!("s{i}"), None)
+                .unwrap();
+            selected.insert(worker.url().to_string());
+            receipt.dispatched();
+            receipt.terminal();
+            drop(receipt);
+        }
+        assert_eq!(selected.len(), 12);
+        assert_eq!(policy.close("m", "s0").unwrap()["binding_released"], true);
+        assert!(policy.reserve(&workers, "m", "s0", None).is_err());
+        policy.close("m", "late-first").unwrap();
+        assert!(policy.reserve(&workers, "m", "late-first", None).is_err());
+    }
+    #[test]
+    fn close_race_waits_for_terminal_receipt_and_abort_ack_cannot_release_uncertainty() {
+        let policy = SessionLeastLoadPolicy::new();
+        let workers = workers();
+        let (_, receipt) = policy.reserve(&workers, "m", "ok", None).unwrap();
+        receipt.dispatched();
+        assert_eq!(policy.close("m", "ok").unwrap()["binding_released"], false);
+        assert!(policy.reserve(&workers, "m", "ok", None).is_err());
+        receipt.terminal();
+        drop(receipt);
+        assert_eq!(policy.close("m", "ok").unwrap()["binding_released"], true);
+        let (_, receipt) = policy.reserve(&workers, "m", "unknown", None).unwrap();
+        receipt.dispatched();
+        drop(receipt);
+        assert!(policy.reserve(&workers, "m", "unknown", None).is_err());
+        for _ in 0..3 {
+            let ack = policy.close("m", "unknown").unwrap();
+            assert_eq!(ack["sealed"], true);
+            assert_eq!(ack["binding_released"], false);
+            assert_eq!(ack["cleanup_unconfirmed"], 1);
+            assert_eq!(ack["physical_cleanup_confirmed"], false);
+        }
+        assert!(workers.iter().all(|w| w.load() == 0));
+    }
+    #[test]
+    fn namespace_and_primary_load_override_bound_session_ties() {
+        let policy = SessionLeastLoadPolicy::new();
+        let workers = workers();
+        for w in &workers[..11] {
+            w.increment_load();
+        }
+        let (picked, receipt) = policy.reserve(&workers, "a", "same", None).unwrap();
+        assert!(Arc::ptr_eq(&picked, &workers[11]));
+        drop(receipt);
+        policy.close("a", "same").unwrap();
+        assert!(policy.reserve(&workers, "b", "same", None).is_ok());
+        for w in &workers[..11] {
+            w.decrement_load();
+        }
+    }
+}
